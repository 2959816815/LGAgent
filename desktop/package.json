{
  "name": "langgraph-agent",
  "private": true,
  "version": "0.2.2",
  "description": "LangGraph desktop agent with local file, Office, web and subagent tools",
  "author": "LangGraph Agent",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173\" \"wait-on http://localhost:5173 && node launch-electron.cjs\"",
    "build": "vite build",
    "test": "vitest run && node --test settings.test.cjs",
    "test:e2e": "node e2e/smoke.cjs",
    "dist:win": "pnpm build && node ../packaging/build-sidecar.mjs && electron-builder --win nsis --config electron-builder.yml",
    "dist:win:fast": "pnpm build && electron-builder --win nsis --config electron-builder.yml"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.83",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "43.3.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "wait-on": "^8.0.1"
  }
}
