{
  "servers": [
    {
      "id": "playwright",
      "name": "Playwright",
      "enabled": true,
      "command": [
        "node",
        "desktop/node_modules/@playwright/mcp/cli.js",
        "--browser",
        "chromium",
        "--headless",
        "--no-sandbox",
        "--isolated"
      ],
      "cwd": ".",
      "permission": "ask",
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "D:\\Vibecoding\\Langgraph\\.playwright-cache",
        "PWTEST_SERVER_REGISTRY": "D:\\Vibecoding\\Langgraph\\.playwright-state\\b",
        "PWTEST_DAEMON_SESSION_DIR": "D:\\Vibecoding\\Langgraph\\.playwright-state\\daemon",
        "TEMP": "D:\\Vibecoding\\Langgraph\\.playwright-temp",
        "TMP": "D:\\Vibecoding\\Langgraph\\.playwright-temp"
      }
    },
    {
      "id": "fetch",
      "name": "Fetch",
      "enabled": false,
      "command": ["uvx", "mcp-server-fetch"],
      "cwd": ".",
      "permission": "ask"
    }
  ]
}
