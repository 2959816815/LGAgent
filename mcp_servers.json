{
  "servers": [
    {
      "id": "playwright",
      "name": "Playwright",
      "enabled": true,
      "command": [
        "node",
        "desktop/node_modules/@playwright/mcp/cli.js",
        "--browser",
        "chrome",
        "--headless",
        "--isolated"
      ],
      "cwd": ".",
      "permission": "ask"
    },
    {
      "id": "fetch",
      "name": "Fetch",
      "enabled": false,
      "command": ["uvx", "mcp-server-fetch"],
      "cwd": ".",
      "permission": "ask"
    }
  ]
}
